{
  "name": "frameproof",
  "version": "0.1.0",
  "private": true,
  "description": "FrameProof: a creative direction and visual quality workspace. Design with intention.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prepare:image-tools": "node scripts/prepare-image-tools.mjs",
    "predev": "npm run prepare:image-tools",
    "prebuild": "npm run prepare:image-tools",
    "prebuild:static": "npm run prepare:image-tools",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "samples": "node scripts/make-samples.mjs",
    "record:ai": "node scripts/record-ai-fixture.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  }
}
