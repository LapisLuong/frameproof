# FrameProof works fully without any of these. Copy to .env.local to enable AI-assisted review.
# Keys are read on the server only (src/app/api/review/route.ts) and never sent to the browser.

# anthropic | openai  (leave empty to keep AI review off)
AI_PROVIDER=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5-5
# AI_MODEL=claude-sonnet-5-5

# OpenAI or any OpenAI-compatible endpoint with vision + JSON output
OPENAI_API_KEY=
# Leave OPENAI_BASE_URL unset for OpenAI. Set it only for a trusted compatible provider
# and use a key issued by that provider. HTTPS is required outside loopback.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Required for openai: the vision-capable model id you have access to
# AI_MODEL=

# Free option: Google Gemini through its OpenAI-compatible endpoint.
# Get a key at https://aistudio.google.com/apikey (Google account, no card needed for the free tier), then:
# AI_PROVIDER=openai
# OPENAI_API_KEY=<your Gemini key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=<vision-capable model ID from Google AI Studio>
# Free-tier requests may be used by Google to improve its products; don't send client work you can't share.

# Request timeout for the model call, in milliseconds
AI_TIMEOUT_MS=60000
